# ==============================================================================
# VARIABLES DE ENTORNO - LeGué Estudio Jurídico
# Copiar este archivo a .env.local para desarrollo local (nunca subir claves reales al repositorio)
# ==============================================================================

# Clave de API generada en Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Casilla de correo de destino donde se recibirán las consultas web (casilla confirmada)
CONTACT_TO_EMAIL=legueabogados@gmail.com

# Remitente verificado en Resend bajo el dominio legueabogados.com.ar
CONTACT_FROM_EMAIL=LeGué Estudio Jurídico <contacto@legueabogados.com.ar>
